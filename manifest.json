{
  "manifest_version": 3,
  "name": "IA Discreta",
  "version": "1.1",
  "description": "Seleciona texto e responde com IA em um balão discreto.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}